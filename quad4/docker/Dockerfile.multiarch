FROM quay.io/quad4-software/golang-ci:1.26 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION
ARG STRING
ARG EDITION="dev"
ARG SRCDIR

WORKDIR /build
RUN --mount=type=bind,target=/build,rw \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-amd64}" ; \
    make -C ${SRCDIR:-.}/quad4 release-linux-docker-${TARGETARCH} \
        ENABLE_VIPS=true DIST=/dist \
        VERSION="${VERSION}" EDITION="${EDITION}" \
        ${STRING:+STRING="${STRING}"}

FROM alpine:3.24
ARG VERSION
ARG REVISION
ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache attr bash ca-certificates curl imagemagick \
                       inotify-tools libc6-compat mailcap tree vips \
		       vips-magick patch && \
    echo 'hosts: files dns' >| /etc/nsswitch.conf

LABEL maintainer="quad4Cloud GmbH <devops@quad4.io>" \
  org.opencontainers.image.title="Quad4 Cloud" \
  org.opencontainers.image.vendor="Quad4 Cloud GmbH" \
  org.opencontainers.image.authors="Quad4 Cloud GmbH" \
  org.opencontainers.image.description="Quad4 Cloud is a modern file-sync and share platform" \
  org.opencontainers.image.licenses="Apache-2.0" \
  org.opencontainers.image.documentation="https://github.com/Quad4-Software/cloud" \
  org.opencontainers.image.url="https://hub.docker.com/r/Quad4-Software/cloud" \
  org.opencontainers.image.source="https://github.com/Quad4-Software/cloud" \
  org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.revision="${REVISION}"

RUN addgroup -g 1000 -S quad4-group && \
  adduser -S --ingroup quad4-group --uid 1000 quad4-user --home /var/lib/quad4

RUN mkdir -p /var/lib/quad4 && \
# Pre-create the web directory to avoid permission issues
 mkdir -p /var/lib/quad4/web/assets/apps && \
 chown -R quad4-user:quad4-group /var/lib/quad4 && \
 chmod -R 751 /var/lib/quad4 && \
 mkdir -p /etc/quad4 && \
 chown -R quad4-user:quad4-group /etc/quad4 && \
 chmod -R 751 /etc/quad4

VOLUME [ "/var/lib/quad4", "/etc/quad4" ]
WORKDIR /var/lib/quad4

USER 1000

EXPOSE 9200/tcp

ENTRYPOINT ["/usr/bin/quad4"]
CMD ["server"]

COPY --from=build /dist/binaries/quad4-linux-${TARGETARCH} /usr/bin/quad4
